{"nodes": [{"id": "readme_tapaiko_ward", "label": "TAPAIKO WARD (Nepal ward-finder Android app)", "file_type": "concept", "source_file": "README.md", "source_location": "1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flutter + flutter_map Android app that reuses the maps-clone deployment's live data URL and file layout so it needs no backend and no local serving (Python not required); the site must stay reachable for uncached data."}, {"id": "readme_municipality_service", "label": "MunicipalityService (locallevelcodes.json \u2192 geometry)", "file_type": "concept", "source_file": "README.md", "source_location": "77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_data_model", "label": "Nepal admin hierarchy data model (province \u2192 district \u2192 locallevel \u2192 ward)", "file_type": "concept", "source_file": "README.md", "source_location": "21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors the maps-clone web app's path-driven layout (province.json \u2192 districts/{province}.json \u2192 locallevels/{district}.json \u2192 wards/{district}_{locallevel}.json) so the same GeoJSON files can be fetched from the live site without a dedicated backend."}, {"id": "readme_locallevelcodes", "label": "locallevelcodes.json (municipality metadata)", "file_type": "concept", "source_file": "README.md", "source_location": "25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ward_district_aliases", "label": "WARD_DISTRICT_ALIASES (Rukum East/West \u2192 Rukum quirk)", "file_type": "concept", "source_file": "README.md", "source_location": "28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ward files are stored under the legacy district name Rukum for Rukum East/Rukum West, so lookups must resolve the alias before opening the wards file."},